# Browser login key for the manager console.
MANAGER_ACCESS_KEY=replace-with-a-long-console-key

# Shared by this manager and all managed Adobe2API instances.
ADOBE2API_OPS_KEY=replace-with-a-long-operations-key

MANAGER_COOKIE_SECURE=true
MANAGER_AUTO_MIGRATE=true
POLL_INTERVAL_SECONDS=30
REMOTE_TIMEOUT_SECONDS=8
METRICS_RETENTION_DAYS=7
EVENT_RETENTION_DAYS=90
DATABASE_URL=sqlite:////app/data/manager.db

# One or more comma-separated generic JSON webhook URLs.
ALERT_WEBHOOK_URLS=

# SMTP is enabled when host, from, and recipients are all configured.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_SMTP_TO=
ALERT_SMTP_STARTTLS=true
